# Puerto de MongoDB en el host, leído por Docker Compose.
MONGO_PORT=27017

# CRUD de rutas. Cada proceso lee su propia configuración de ejecución.
HTTP_ADDR=127.0.0.1:8081
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=trip_forge

# MID de rutas: define HTTP_ADDR=127.0.0.1:8082 en su propia configuración.
# HTTP_ADDR=127.0.0.1:8082

# Pruebas de integración del CRUD. Si queda vacío, se omiten.
MONGODB_TEST_URI=mongodb://127.0.0.1:27017
